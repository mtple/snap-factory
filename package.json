{
  "name": "snap-factory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Farcaster snaps built by Snap Wizard",
  "scripts": {
    "generate": "tsx scripts/generate-registry.ts",
    "refresh-engagement": "node scripts/refresh-engagement.mjs",
    "scout-feed": "node scripts/scout-feed.mjs",
    "prebuild": "npm run generate",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "predev": "npm run generate",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@farcaster/snap": "^2.3.1",
    "@farcaster/snap-hono": "^2.1.2",
    "@farcaster/snap-turso": "^2.0.9",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
