{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/snaps/:name",
      "destination": "/api/snaps/:name"
    },
    {
      "source": "/snaps/:name/:path*",
      "destination": "/api/snaps/:name/:path*"
    }
  ]
}
